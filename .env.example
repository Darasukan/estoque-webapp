DB_PATH=./server/estoque-dev.db
PHOTO_UPLOAD_DIR=./server/photo-uploads-dev
PORT=3000
BACKUP_ENABLED=true
BACKUP_INTERVAL_HOURS=24
# Retenção em camadas: recentes, um por dia e um por mês.
BACKUP_KEEP_HOURLY=24
BACKUP_KEEP_DAILY=30
BACKUP_KEEP_MONTHLY=12
# Opcional: use um pendrive ou outro disco. No mesmo disco, não protege contra falha física.
BACKUP_MIRROR_DIR=
CORS_ORIGINS=
ENABLE_SEED_ROUTES=false
VITE_ENABLE_SEED_TOOLS=false
GEMINI_API_KEY=
GEMINI_MODEL=gemini-3.1-flash-lite
